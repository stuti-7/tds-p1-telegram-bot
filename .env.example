# Copy to .env and fill in. .env is gitignored - never commit real tokens.
# On Render/Railway set these in the dashboard instead of shipping a .env.

# From @BotFather -> /newbot (or /token for an existing bot)
TELEGRAM_BOT_TOKEN=

# From https://aipipe.org/login - a long string starting with eyJ...
AIPIPE_TOKEN=

# Public, wget-able URL to run.jsonl. Must return raw text with no login.
# After pushing run.jsonl to your public repo this is the "Raw" link:
LOG_URL=https://raw.githubusercontent.com/YOUR_USERNAME/YOUR_REPO/main/run.jsonl

# --- optional tuning (defaults shown) ---------------------------------------
# MODEL=gpt-5-mini
# AIPIPE_BASE_URL=https://aipipe.org/openai/v1

# Budgets. The grader allows ~300s per question; these leave a wide margin.
# AGENT_DEADLINE_SECONDS=150
# LLM_TIMEOUT_SECONDS=60
# LLM_RETRIES=2

# Let the agent compute and read public datasets. Set to 0 for a single plain call.
# ENABLE_TOOLS=1
# MAX_TOOL_STEPS=4
# PYTHON_TIMEOUT_SECONDS=20
# FETCH_TIMEOUT_SECONDS=25

# Auto commit+push run.jsonl every N logged events (0 = off, push manually).
# Requires the host to have push credentials for the repo.
# PUBLISH_EVERY=0
# PUBLISH_MIN_INTERVAL_SECONDS=60

# HISTORY_TURNS=8
